generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider  = "postgresql"
}

model User {
  id                    String                @id @default(cuid())
  name                  String?
  email                 String                @unique
  emailVerified         DateTime?
  image                 String?
  password              String?
  role                  UserRole              @default(TEAM_MEMBER)
  profileRole           ProfileRole?          @default(EMPLOYEE)
  title                 String?
  employeeId            String?               @unique
  department            String?
  location              String?
  employmentType        String?
  dateOfJoining         DateTime?
  dateOfConfirmation    DateTime?
  dateOfBirth           DateTime?
  gender                String?
  maritalStatus         String?
  workMobile            String?
  personalMobile        String?
  parentGuardianName    String?
  parentGuardianMobile  String?
  permanentAddress      String?
  personalEmail         String?
  aadharNumber          String?
  bankAccountNumber     String?
  ifscCode              String?
  isActive              Boolean               @default(true)
  reportingToId         String?
  secondaryReportingToId String?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  reportingTo           User?                   @relation("ReportsTo", fields: [reportingToId], references: [id], onDelete: SetNull)
  directReports         User[]                  @relation("ReportsTo")
  secondaryReportingTo  User?                   @relation("SecondaryReportsTo", fields: [secondaryReportingToId], references: [id], onDelete: SetNull)
  secondaryReports      User[]                  @relation("SecondaryReportsTo")
  documents             UserDocument[]
  accounts              Account[]
  blockerComments       BlockerComment[]
  boards                Board[]
  boardShares           BoardShare[]
  boardNotes            BoardNote[]
  noteShares            BoardNoteShare[]
  competencyAttributes  CompetencyAttribute[]
  workspaceNote         DsmWorkspaceNote?     @relation("WorkspaceNotes")
  reviewedDsrs          DsrEntry[]            @relation("DsrReviewedBy")
  dsrEntries            DsrEntry[]            @relation("UserDsrEntries")
  icebergProfile        IcebergProfile?
  icaDocuments          IcaDocument[]
  notes                 Note[]
  notebooks             Notebook[]
  zohoAccount           ZohoAccount?
  sentNotifications     Notification[]        @relation("SentNotifications")
  receivedNotifications Notification[]        @relation("ReceivedNotifications")
  roleTaskDocuments     RoleTaskDocument[]
  sessions              Session[]
  blockerMentions       StandupBlocker[]            @relation("BlockerMentions")
  blockerEdits          StandupBlocker[]            @relation("BlockerEditedBy")
  blockerMultiMentions  StandupBlockerMention[]     @relation("BlockerMultiMentions")
  reviewedStandups      StandupEntry[]              @relation("ReviewedStandups")
  standupEntries        StandupEntry[]              @relation("UserStandups")
  taskAdds              StandupTask[]               @relation("TaskAddedBy")
  taskEdits             StandupTask[]               @relation("TaskEditedBy")
  supportMentions       StandupSupportNeed[]        @relation("SupportMentions")
  supportEdits          StandupSupportNeed[]        @relation("SupportEditedBy")
  supportMultiMentions  StandupSupportNeedMention[]   @relation("SupportMultiMentions")
  supportNeedComments   SupportNeedComment[]
  tags                  Tag[]
  ledTeams              Team[]                @relation("TeamLead")
  teamMemberships       TeamMember[]
  authoredThreads       Thread[]
  threadShares          ThreadShare[]
  organizedEvents       CalendarEvent[]        @relation("OrganizedEvents")
  eventAttending        CalendarEventAttendee[]
  ownedProjects         Project[]              @relation("ProjectOwner")
  createdProjects       Project[]              @relation("ProjectCreator")
  ownedTasks            ProjectTask[]          @relation("TaskOwner")
  authoredTasks         ProjectTask[]          @relation("TaskAuthor")
  projectMemberships    ProjectMember[]
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

model StandupEntry {
  id            String               @id @default(cuid())
  date          DateTime
  status        StandupStatus        @default(DRAFT)
  submittedAt   DateTime?
  reviewedAt    DateTime?
  reviewedById  String?
  reviewComment String?
  learningText  String?
  userId        String
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  blockers      StandupBlocker[]
  reviewedBy    User?                @relation("ReviewedStandups", fields: [reviewedById], references: [id], onDelete: SetNull)
  user          User                 @relation("UserStandups", fields: [userId], references: [id], onDelete: Cascade)
  supportNeeds  StandupSupportNeed[]
  tasks         StandupTask[]
  timelineEvents StandupTimelineEvent[]

  @@unique([userId, date])
}

model StandupTask {
  id               String        @id @default(cuid())
  entryId          String
  kind             TaskKind
  text             String
  order            Int           @default(0)
  priority         String?
  managerPriority  String?
  addedAfterReview Boolean       @default(false)
  addedById        String?
  editedById       String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  entry            StandupEntry  @relation(fields: [entryId], references: [id], onDelete: Cascade)
  addedBy          User?         @relation("TaskAddedBy", fields: [addedById], references: [id], onDelete: SetNull)
  editedBy         User?         @relation("TaskEditedBy", fields: [editedById], references: [id], onDelete: SetNull)
}

model StandupTimelineEvent {
  id         String       @id @default(cuid())
  entryId    String
  type       String
  label      String
  occurredAt DateTime
  createdAt  DateTime     @default(now())
  entry      StandupEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
}

model StandupBlocker {
  id              String                  @id @default(cuid())
  entryId         String
  text            String
  priority        BlockerPriority         @default(MEDIUM)
  resolved        Boolean                 @default(false)
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  mentionedUserId String?
  mentionedUserIds String?
  editedById      String?
  comments        BlockerComment[]
  mentions        StandupBlockerMention[]
  entry           StandupEntry            @relation(fields: [entryId], references: [id], onDelete: Cascade)
  mentionedUser   User?                   @relation("BlockerMentions", fields: [mentionedUserId], references: [id], onDelete: SetNull)
  editedBy        User?                   @relation("BlockerEditedBy", fields: [editedById], references: [id], onDelete: SetNull)
}

model StandupBlockerMention {
  id        String         @id @default(cuid())
  blockerId String
  userId    String
  createdAt DateTime       @default(now())
  blocker   StandupBlocker @relation(fields: [blockerId], references: [id], onDelete: Cascade)
  user      User           @relation("BlockerMultiMentions", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([blockerId, userId])
}

model BlockerComment {
  id        String         @id @default(cuid())
  blockerId String
  authorId  String
  text      String
  createdAt DateTime       @default(now())
  author    User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  blocker   StandupBlocker @relation(fields: [blockerId], references: [id], onDelete: Cascade)
}

model StandupSupportNeed {
  id              String                      @id @default(cuid())
  entryId         String
  text            String
  mentionedUserId String?
  mentionedUserIds String?
  editedById      String?
  eventId         String?
  order           Int                         @default(0)
  resolved        Boolean                     @default(false)
  createdAt       DateTime                    @default(now())
  updatedAt       DateTime                    @updatedAt
  mentions        StandupSupportNeedMention[]
  entry           StandupEntry                @relation(fields: [entryId], references: [id], onDelete: Cascade)
  mentionedUser   User?                       @relation("SupportMentions", fields: [mentionedUserId], references: [id], onDelete: SetNull)
  editedBy        User?                       @relation("SupportEditedBy", fields: [editedById], references: [id], onDelete: SetNull)
  event           CalendarEvent?              @relation(fields: [eventId], references: [id], onDelete: SetNull)
  comments        SupportNeedComment[]
}

model StandupSupportNeedMention {
  id            String             @id @default(cuid())
  supportNeedId String
  userId        String
  createdAt     DateTime           @default(now())
  supportNeed   StandupSupportNeed @relation(fields: [supportNeedId], references: [id], onDelete: Cascade)
  user          User               @relation("SupportMultiMentions", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([supportNeedId, userId])
}

model SupportNeedComment {
  id            String             @id @default(cuid())
  supportNeedId String
  authorId      String
  text          String
  createdAt     DateTime           @default(now())
  author        User               @relation(fields: [authorId], references: [id], onDelete: Cascade)
  supportNeed   StandupSupportNeed @relation(fields: [supportNeedId], references: [id], onDelete: Cascade)
}

model DsmWorkspaceNote {
  id          String          @id @default(cuid())
  title       String
  body        String
  keyNote     String?
  ownerId     String          @unique
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  actionItems DsmActionItem[]
  owner       User            @relation("WorkspaceNotes", fields: [ownerId], references: [id], onDelete: Cascade)
}

model DsmActionItem {
  id        String           @id @default(cuid())
  noteId    String
  text      String
  checked   Boolean          @default(false)
  order     Int              @default(0)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  note      DsmWorkspaceNote @relation(fields: [noteId], references: [id], onDelete: Cascade)
}

model Notification {
  id             String           @id @default(cuid())
  type           NotificationType
  title          String
  message        String
  userId         String
  createdById    String
  readAt         DateTime?
  relatedEntryId String?
  teamId         String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  createdBy      User             @relation("SentNotifications", fields: [createdById], references: [id], onDelete: Cascade)
  user           User             @relation("ReceivedNotifications", fields: [userId], references: [id], onDelete: Cascade)
}

model Team {
  id              String       @id @default(cuid())
  name            String
  department      String?
  description     String?
  requireApproval Boolean      @default(false)
  notifyMembers   Boolean      @default(true)
  allowEdits      Boolean      @default(false)
  leadId          String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  lead            User?        @relation("TeamLead", fields: [leadId], references: [id], onDelete: SetNull)
  members         TeamMember[]
}

model TeamMember {
  id        String   @id @default(cuid())
  teamId    String
  userId    String
  createdAt DateTime @default(now())
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
}

enum ProfileRole {
  EMPLOYEE
  MANAGER
  CONTRACTOR
  CLIENT
  GUEST
  DEVELOPER
  SUPPORT
  ADMIN
  PORTAL_OWNER
}

enum PermissionScope {
  NONE
  OWNED
  ALL
  BOTH
}

model PermissionModule {
  id          String              @id @default(cuid())
  profileType String              @default("USER") // "USER" | "CLIENT" | "SYSTEM"
  key         String
  name        String
  order       Int                 @default(0)
  actions     PermissionAction[]

  @@unique([profileType, key])
}

model PermissionAction {
  id          String            @id @default(cuid())
  moduleId    String
  key         String
  label       String
  controlType String            // "BOOLEAN" | "SCOPE"
  order       Int               @default(0)
  module      PermissionModule  @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  rules       PermissionRule[]

  @@unique([moduleId, key])
}

model PermissionRule {
  id        String            @id @default(cuid())
  role      ProfileRole
  actionId  String
  enabled   Boolean           @default(false)
  scope     PermissionScope   @default(NONE)
  scopeAssignee Boolean       @default(false) // meaningful when scope = BOTH
  scopeOwner    Boolean       @default(false) // meaningful when scope = BOTH
  action    PermissionAction  @relation(fields: [actionId], references: [id], onDelete: Cascade)

  @@unique([role, actionId])
}

model UserDocument {
  id        String   @id @default(cuid())
  userId    String
  kind      String
  fileUrl   String
  fileName  String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model DsrEntry {
  id                 String               @id @default(cuid())
  userId             String
  date               DateTime
  status             DsrStatus            @default(DRAFT)
  completionPercent  Int                  @default(0)
  plannedTaskCount   Int                  @default(0)
  completedTaskCount Int                  @default(0)
  sentiment          DsrSentiment?
  resultOfDay        String?
  reflection         String?
  managerComment     String?
  submittedAt        DateTime?
  reviewedAt         DateTime?
  reviewedById       String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  additionalWorks    DsrAdditionalWork[]
  reviewedBy         User?                @relation("DsrReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  user               User                 @relation("UserDsrEntries", fields: [userId], references: [id], onDelete: Cascade)
  followUpsDone      DsrFollowUpDone[]
  learningItems      DsrLearningItem[]
  plannedTasks       DsrPlannedTask[]
  resolvedBlockers   DsrResolvedBlocker[]
  timelineEvents     DsrTimelineEvent[]

  @@unique([userId, date])
}

model DsrPlannedTask {
  id               String   @id @default(cuid())
  dsrEntryId       String
  text             String
  priority         String?
  completed        Boolean       @default(false)
  addedAfterReview Boolean       @default(false)
  order            Int           @default(0)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  dsrEntry         DsrEntry      @relation(fields: [dsrEntryId], references: [id], onDelete: Cascade)
}

model DsrAdditionalWork {
  id         String   @id @default(cuid())
  dsrEntryId String
  text       String
  order      Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  dsrEntry   DsrEntry @relation(fields: [dsrEntryId], references: [id], onDelete: Cascade)
}

model DsrResolvedBlocker {
  id         String   @id @default(cuid())
  dsrEntryId String
  text       String
  resolved   Boolean  @default(true)
  order      Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  dsrEntry   DsrEntry @relation(fields: [dsrEntryId], references: [id], onDelete: Cascade)
}

model DsrFollowUpDone {
  id         String   @id @default(cuid())
  dsrEntryId String
  text       String
  completed  Boolean  @default(true)
  order      Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  dsrEntry   DsrEntry @relation(fields: [dsrEntryId], references: [id], onDelete: Cascade)
}

model DsrLearningItem {
  id         String   @id @default(cuid())
  dsrEntryId String
  text       String
  completed  Boolean  @default(false)
  order      Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  dsrEntry   DsrEntry @relation(fields: [dsrEntryId], references: [id], onDelete: Cascade)
}

model DsrTimelineEvent {
  id         String   @id @default(cuid())
  dsrEntryId String
  type       String
  label      String
  occurredAt DateTime
  createdAt  DateTime @default(now())
  dsrEntry   DsrEntry @relation(fields: [dsrEntryId], references: [id], onDelete: Cascade)
}

model Notebook {
  id        String   @id @default(cuid())
  name      String
  color     String?
  ownerId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  notes     Note[]
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@unique([name, ownerId])
}

model Tag {
  id        String    @id @default(cuid())
  name      String
  ownerId   String
  createdAt DateTime  @default(now())
  notes     NoteTag[]
  owner     User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@unique([name, ownerId])
}

model NoteTag {
  noteId String
  tagId  String
  note   Note   @relation(fields: [noteId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([noteId, tagId])
}

model ChecklistItem {
  id        String   @id @default(cuid())
  text      String
  checked   Boolean  @default(false)
  position  Int      @default(0)
  noteId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  note      Note     @relation(fields: [noteId], references: [id], onDelete: Cascade)
}

model Note {
  id             String          @id @default(cuid())
  title          String
  content        String
  type           NoteType        @default(TEXT)
  color          String?
  isPinned       Boolean         @default(false)
  reminderAt     DateTime?
  notebookId     String?
  authorId       String
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  checklistItems ChecklistItem[]
  author         User            @relation(fields: [authorId], references: [id], onDelete: Cascade)
  notebook       Notebook?       @relation(fields: [notebookId], references: [id])
  tags           NoteTag[]
}

model OtpToken {
  id             String    @id @default(cuid())
  email          String
  code           String
  expiresAt      DateTime
  usedAt         DateTime?
  failedAttempts Int       @default(0)
  createdAt      DateTime  @default(now())

  @@index([email])
}

model Board {
  id        String       @id @default(cuid())
  name      String
  ownerId   String
  type      String       @default("NORMAL") // "DSM" | "NORMAL"
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  owner     User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  threads   Thread[]
  shares    BoardShare[]

  @@unique([name, ownerId])
}

model BoardShare {
  boardId   String
  userId    String
  canEdit   Boolean  @default(false)
  createdAt DateTime @default(now())
  board     Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([boardId, userId])
}

model Thread {
  id        String        @id @default(cuid())
  title     String
  boardId   String

  authorId  String
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  notes     BoardNote[]
  author    User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  board     Board         @relation(fields: [boardId], references: [id], onDelete: Cascade)
  shares    ThreadShare[]
}

model ThreadShare {
  threadId  String
  userId    String
  canEdit   Boolean  @default(false)
  createdAt DateTime @default(now())
  thread    Thread   @relation(fields: [threadId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([threadId, userId])
}

model BoardNote {
  id             String                   @id @default(cuid())
  title          String?
  content        String
  color          String?                  @default("#ffffff")
  deadline       DateTime?
  threadId       String
  authorId       String
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  author         User                     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  thread         Thread                   @relation(fields: [threadId], references: [id], onDelete: Cascade)
  checklistItems BoardNoteChecklistItem[]
  shares         BoardNoteShare[]
}

model BoardNoteShare {
  noteId    String
  userId    String
  canEdit   Boolean   @default(false)
  createdAt DateTime  @default(now())
  note      BoardNote @relation(fields: [noteId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([noteId, userId])
}

model BoardNoteChecklistItem {
  id        String    @id @default(cuid())
  text      String
  checked   Boolean   @default(false)
  position  Int       @default(0)
  noteId    String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  note      BoardNote @relation(fields: [noteId], references: [id], onDelete: Cascade)
}





model CompetencyAttribute {
  id        String             @id @default(cuid())
  userId    String
  category  CompetencyCategory
  name      String
  status    CompetencyStatus   @default(MATCHED)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, category, name])
}

model IcebergProfile {
  id            String    @id @default(cuid())
  userId        String    @unique
  coachingNotes String?
  fileName      String?
  fileUrl       String?
  uploadedOn    DateTime?
  comment       String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RoleTaskDocument {
  id           String   @id @default(cuid())
  taskName     String
  fileName     String
  fileUrl      String
  fileType     String
  uploadedOn   DateTime @default(now())
  userId       String
  comment      String?
  managerNotes String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model IcaDocument {
  id         String   @id @default(cuid())
  userId     String
  fileName   String
  fileUrl    String
  fileType   String?
  comment    String?
  uploadedOn DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ZohoAccount {
  id                 String   @id @default(cuid())
  userId             String   @unique
  accessToken        String
  refreshToken       String
  expiresAt          DateTime
  apiDomain          String
  accountsDomain     String
  zohoEmail          String?
  primaryCalendarUid String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CalendarEvent {
  id             String                  @id @default(cuid())
  title          String
  description    String?
  meetingType    String                  @default("online")
  location       String?
  meetingMode    String?                 @default("audio")
  isRecording    Boolean                 @default(false)
  meetingLink    String?
  alertType      String?                 @default("zia")
  start          DateTime
  end            DateTime
  isAllDay       Boolean                 @default(false)
  recurrenceRule String?
  zohoEventId    String?
  organizerId    String
  organizer      User                    @relation("OrganizedEvents", fields: [organizerId], references: [id], onDelete: Cascade)
  attendees      CalendarEventAttendee[]
  supportNeeds   StandupSupportNeed[]
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
}

model CalendarEventAttendee {
  id        String        @id @default(cuid())
  eventId   String
  userId    String?
  email     String
  status    String        @default("NEEDS_ACTION")
  role      String?       @default("PARTICIPANT")
  event     CalendarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user      User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime      @default(now())

  @@unique([eventId, email])
}

enum UserRole {
  TEAM_MEMBER
  MANAGER
}

enum NoteType {
  TEXT
  CHECKLIST
}

enum StandupStatus {
  DRAFT
  SUBMITTED
  PENDING_REVIEW
  REVIEWED
  MISSED
}

enum TaskKind {
  YESTERDAY
  TODAY
}

enum BlockerPriority {
  LOW
  MEDIUM
  HIGH
}

enum TaskPriority {
  P1
  P2
  P3
}

enum NotificationType {
  DSM_REMINDER
  CALENDAR_INVITE
  PROJECT_ASSIGNED
}

enum DsrStatus {
  DRAFT
  SUBMITTED
  PENDING_REVIEW
  REVIEWED
  MISSED
}

enum DsrSentiment {
  BREAKTHROUGH
  BREAKDOWN
}

enum CompetencyCategory {
  SKILL
  KNOWLEDGE
  SELF_IMAGE
  TRAIT
  MOTIVE
}

enum CompetencyStatus {
  MATCHED
  EXTRA
  MISSING
}

model Project {
  id               String            @id @default(cuid())
  code             String?           @unique
  name             String
  progressPercent  Int               @default(0)
  ownerId          String?
  createdByUserId  String?
  ownerName        String?
  ownerInitials    String?
  ownerAvatarColor String?
  status           String            @default("ACTIVE")
  projectCategory  String?           @default("CLIENT_DELIVERY")
  departmentAlias  String?           @default("digitalproducts@")
  templateUsed     String?
  isClientVisible  Boolean           @default(true)
  totalHours       String            @default("00:00 h")
  billableHours    String            @default("00:00 h")
  nonBillableHours String            @default("00:00 h")
  startDate        String?
  deadline         String?
  description      String?
  associatedTeam   String?
  priority         String?           @default("None")
  tags             String[]          @default([])
  reminder         String?
  billingType      String?           @default("Fixed Rate")
  group            String?
  businessHours    String?           @default("Standard Business Hours")
  taskLayout       String?           @default("New Project Template")
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  owner            User?             @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  createdByUser    User?             @relation("ProjectCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  phases           ProjectPhase[]
  taskLists        ProjectTaskList[]
  tasks            ProjectTask[]
  timeLogs         ProjectTimeLog[]
  members          ProjectMember[]
}

model ProjectMember {
  id        String   @id @default(cuid())
  projectId String
  userId    String
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
}

model ProjectPhase {
  id          String   @id @default(cuid())
  code        String
  name        String
  isCompleted Boolean  @default(false)
  order       Int      @default(0)
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
}

model ProjectTaskList {
  id        String        @id @default(cuid())
  name      String
  flag      String        @default("external") // "internal" | "external"
  status    String        @default("Active")
  sequence  Int           @default(1)
  phaseCode String?
  projectId String
  project   Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt DateTime      @default(now())
  tasks     ProjectTask[]
}

model ProjectTask {
  id                   String                @id @default(cuid())
  code                 String
  title                String
  phaseCode            String?
  phaseName            String?
  taskListId           String?
  taskListName         String?
  isExternal           Boolean               @default(true)
  status               String                @default("Open")
  authorId             String?
  authorName           String?
  associatedTeam       String?
  departmentAlias      String?               @default("digitalproducts@")
  ownerId              String?
  owner                String?               @default("Unassigned")
  owners               String[]              @default([])
  workHours            String?               @default("00:00")
  startDate            String?               @default("--")
  dueDate              String?               @default("--")
  duration             String?               @default("2 days/hrs")
  completionPercentage Int                   @default(0)
  recurrence           String?               @default("None")
  priority             String?               @default("None")
  tags                 String[]              @default([])
  reminder             String?               @default("None")
  billingType          String?               @default("None")
  description          String?
  isWarning            Boolean               @default(false)
  staleAlert           Boolean               @default(false)
  lastActivityDate     DateTime?
  hasAttachments       Boolean               @default(false)
  hasComments          Boolean               @default(false)
  hasReminder          Boolean               @default(false)
  hasRecurrence        Boolean               @default(false)
  projectId            String?
  project              Project?              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  taskList             ProjectTaskList?      @relation(fields: [taskListId], references: [id], onDelete: SetNull)
  ownerUser            User?                 @relation("TaskOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  author               User?                 @relation("TaskAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  subtasks             ProjectSubtask[]
  remarks              ProjectTaskRemark[]
  activities           ProjectTaskActivity[]
}

model ProjectSubtask {
  id        String      @id @default(cuid())
  code      String
  title     String
  status    String      @default("Open")
  ownerName String?     @default("Unassigned")
  startDate String?     @default("--")
  dueDate   String?     @default("--")
  completed Boolean     @default(false)
  hasLink   Boolean     @default(false)
  taskId    String
  task      ProjectTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now())
}

model ProjectTaskRemark {
  id                String      @id @default(cuid())
  authorName        String
  authorInitials    String
  authorAvatarColor String?     @default("bg-blue-600 text-white")
  content           String
  taskId            String
  task              ProjectTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  createdAt         DateTime    @default(now())
}

model ProjectTaskActivity {
  id           String      @id @default(cuid())
  userName     String
  userInitials String
  actionText   String
  taskId       String
  task         ProjectTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  createdAt    DateTime    @default(now())
}

model ProjectTimeLog {
  id           String   @id @default(cuid())
  code         String
  title        String
  project      String
  taskCode     String?
  duration     String
  timePeriod   String
  date         String   @default("11/07/2026")
  billingType  String   @default("NON BILLABLE")
  remarks      String?
  approvalStatus String @default("Pending")
  userName     String?
  userInitials String?
  avatarColor  String?
  projectId    String?
  projectRel   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
}
